<?xml version="1.0" encoding="utf-8"?>
<!--
  Privacy: saved places can reveal home/work. Exclude the Room DB from cloud
  backup and device transfer. FLAG: change this if the user opts into backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="gps_tracker.db" />
        <exclude domain="database" path="gps_tracker.db-shm" />
        <exclude domain="database" path="gps_tracker.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="gps_tracker.db" />
        <exclude domain="database" path="gps_tracker.db-shm" />
        <exclude domain="database" path="gps_tracker.db-wal" />
    </device-transfer>
</data-extraction-rules>
